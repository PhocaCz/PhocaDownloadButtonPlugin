		</downloads>
		<tags>
			<tag>stable</tag>
		</tags>
		<maintainer><![CDATA[ Phoca.cz ]]></maintainer>
		<maintainerurl>https://www.phoca.cz/</maintainerurl>
		<section>Updates</section>
		<targetplatform name="joomla" version="3.([89]|10)"/>
		<client>site</client>
